rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    match /profiles/{uid} {
      allow read: if owner(uid) || isAdmin();
      allow write: if false; // Created and modified by trusted Cloud Functions only.
    }
    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow write: if false;
    }
    match /punchLedger/{entryId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow write: if false;
    }
    match /rewards/{rewardId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
