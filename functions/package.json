{
  "name": "baked-with-hope-sweet-club-functions",
  "private": true,
  "engines": {"node": "22"},
  "main": "index.js",
  "scripts": {
    "lint": "node --check index.js && node --check loyalty.js",
    "test": "node --test test/loyalty.test.js",
    "test:rules": "firebase --config ../firebase.json --project baked-with-hope-preview-test emulators:exec --only firestore \"node --test test/firestore.rules.test.js\"",
    "serve": "firebase emulators:start --only auth,firestore,functions",
    "deploy": "firebase deploy --only firestore:rules,functions"
  },
  "dependencies": {"firebase-admin": "^13.0.0", "firebase-functions": "^6.0.0"},
  "devDependencies": {"@firebase/rules-unit-testing": "^5.0.0", "firebase": "^12.0.0", "firebase-tools": "^15.34.0"}
}
